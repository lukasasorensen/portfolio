# OpenAI credentials (required for the /chat feature)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated blocklists
# CHAT_BANNED_IPS=203.0.113.10,198.51.100.7
# CHAT_BANNED_DEVICE_IDS=deviceabc123,devicexyz789

# Optional: chat API rate limit controls
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=10
# CHAT_RATE_LIMIT_MAX_REQUESTS_PER_DAY=100
